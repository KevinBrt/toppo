# Toppo configuration. Copy to .env next to docker-compose.yml and adjust.
#
# TOPPO_* variables are read by Toppo itself. Unknown TOPPO_* variables stop the server at
# startup, to catch typos. Any of them can be read from a file by appending _FILE
# (Docker secrets), e.g. TOPPO_DATABASE_URL_FILE=/run/secrets/toppo_database_url

# --- docker-compose.yml only ----------------------------------------------------------------

# Required. Password of the bundled PostgreSQL. Use hex so it is safe inside a URL:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Image tag to run. Pin a version (e.g. 0.1.0) in production; "latest" follows releases.
IMAGE_TAG=latest

# Port published on the host.
HTTP_PORT=3000

# --- Toppo ----------------------------------------------------------------------------------

# Public URL users open, without path. Use https:// behind a TLS reverse proxy:
# it enables HSTS and upgrades insecure requests.
TOPPO_URL=http://localhost:3000

# PostgreSQL 16+ connection string. docker-compose.yml sets it for the bundled database;
# set it yourself when using an external server.
# TOPPO_DATABASE_URL=postgres://toppo:password@db.example.com:5432/toppo?sslmode=require

# Trust X-Forwarded-* headers. Enable only when Toppo is reachable solely through your proxy.
TOPPO_TRUST_PROXY=false

# fatal, error, warn, info, debug, trace or silent.
TOPPO_LOG_LEVEL=info

# Key that signs sessions, at least 32 characters. Leave empty: Toppo generates one into
# /data/secret.key on first start. Set it when several instances share one database.
#   openssl rand -base64 48
TOPPO_SECRET=

# First-run setup code. Leave empty: Toppo prints a random one in its logs at first start
# (docker compose logs toppo). Preset it only for automated deployments; 12+ characters.
TOPPO_SETUP_CODE=

# Directory for persistent files (secret key, attachments). Inside the image: /data.
# TOPPO_DATA_DIR=/data

# Largest file people may attach, in MB (1 MB = 1,048,576 bytes), from 1 to 1024. A reverse
# proxy in front of Toppo must accept requests that large too (nginx: client_max_body_size).
# TOPPO_ATTACHMENT_MAX_SIZE_MB=20

# Once a day, Toppo asks GitHub (api.github.com) for the latest version published, and tells
# those who manage the instance when a newer one is out. Nothing about the instance is sent.
# Set to false on a server cut from the internet, or to make no request at all.
TOPPO_UPDATE_CHECK=true

# Interface and port Toppo listens on inside the container. Rarely needs changing.
# TOPPO_HOST=0.0.0.0
# TOPPO_PORT=3000
