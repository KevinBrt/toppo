    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@toppo/testing": "0.0.0",
    "@types/node": "24.19.2"
  }
}
