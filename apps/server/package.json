{
  "name": "@toppo/server",
  "version": "0.0.0",
  "private": true,
  "description": "Toppo HTTP server: REST API, authentication, background jobs, and the compiled web app.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=dev.env src/main.ts",
    "build": "rolldown -c rolldown.config.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.8",
    "@toppo/core": "0.0.0",
    "@toppo/db": "0.0.0",
    "@toppo/shared": "0.0.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@toppo/testing": "0.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "rolldown": "1.2.15",
    "vitest": "5.0.5"
  }
}
