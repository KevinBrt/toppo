# Development defaults, loaded by `npm run dev`. Variables already set in your shell take precedence.
# These credentials only work against docker/compose.dev.yml, bound to localhost.
TOPPO_HOST=127.0.0.1
TOPPO_DATABASE_URL=postgres://toppo:toppo@127.0.0.1:54329/toppo
TOPPO_URL=http://localhost:5173
TOPPO_LOG_LEVEL=debug
TOPPO_DATA_DIR=.data
# The watcher restarts the server at every change: GitHub is not asked each time.
TOPPO_UPDATE_CHECK=false
